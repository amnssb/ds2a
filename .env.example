# DeepSeek Gateway 容器化环境变量配置模版
# 复制为 .env 即可生效

# 服务监听端口与绑定地址（容器内需绑定 0.0.0.0）
PORT=19728
HOST=0.0.0.0

# 控制台管理员账号密码（首次登录使用）
DS_ADMIN_USER=admin
DS_ADMIN_PASS=admin123

# 是否强制要求外部调用必须携带 API Key (true/false)
DS_REQUIRE_KEY=false

# 会话闲置自动清理时间（分钟）
DS_SESSION_TTL_MIN=15

# 单次请求最大超时时间（毫秒）
DS_TIMEOUT_MS=90000

# 文件上传最大体积上限（MB）
DS_MAX_UPLOAD_MB=30

# 单账号最大并发请求数
DS_MAX_CONCURRENT_PER_ACCOUNT=5

# 连续失败多少次后自动熔断暂停该账号
DS_CIRCUIT_BREAKER_FAIL_LIMIT=2

# 是否开启 PoW 挑战异步预热池（true=0ms放行，false=按需实时计算）
DS_POW_PREWARM=true
